# Exemplo de arquivo .env
# Copie este arquivo para .env e preencha com suas credenciais

# Microsoft Azure AD
CLIENT_ID=seu-client-id-aqui
TENANT_ID=seu-tenant-id-aqui

# Banco de Dados PostgreSQL
DB_HOST="localhost"
DB_NAME="email"
DB_USER="seu-usuario"
DB_PASS="sua-senha"
DB_PORT="5432"

# API de Upload de Notas Fiscais
UPLOAD_API_URL="https://api-upload.exemplo.com"
UPLOAD_API_KEY="sua-api-key-aqui"
